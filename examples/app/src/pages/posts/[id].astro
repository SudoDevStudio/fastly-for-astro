---
import Layout from "../../components/Layout.astro";

const { id } = Astro.params;
if (!id || !/^[a-z0-9-]+$/i.test(id)) {
  return new Response("Invalid post id", { status: 400 });
}

// Pretend to load a post.
const post = {
  id,
  title: id.split("-").map((w) => w[0]?.toUpperCase() + w.slice(1)).join(" "),
  body: `This is the body of post "${id}". Rendered dynamically by Astro SSR.`,
};
---
<Layout title={`Post: ${post.title}`}>
  <article>
    <h2>{post.title}</h2>
    <p>{post.body}</p>
    <p><a href="/">← Home</a></p>
  </article>
</Layout>

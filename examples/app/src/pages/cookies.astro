---
import Layout from "../components/Layout.astro";

const visitsCookie = Astro.cookies.get("visits");
const previous = visitsCookie ? Number.parseInt(visitsCookie.value, 10) : 0;
const visits = Number.isFinite(previous) ? previous + 1 : 1;

Astro.cookies.set("visits", String(visits), {
  path: "/",
  httpOnly: true,
  sameSite: "lax",
  secure: Astro.url.protocol === "https:",
  maxAge: 60 * 60 * 24 * 30,
});
---
<Layout title="Cookies — Astro × Fastly">
  <h2>Cookies</h2>
  <p>Visit count for this browser: <strong>{visits}</strong></p>
  <p>The adapter <em>does not</em> cache responses bearing <code>Set-Cookie</code> by default.</p>
  <p>Reload the page — the counter increments and the response stays uncached.</p>
</Layout>

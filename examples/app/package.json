{
  "name": "app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fastly:install": "cd dist/fastly && npm install",
    "fastly:wasm": "cd dist/fastly && npm run build",
    "fastly:serve:dist": "cd dist/fastly && npx @fastly/compute-js-static-publish publish-content --local && fastly compute serve",
    "fastly:serve": "npm run build && npm run fastly:install && npm run fastly:serve:dist",
    "fastly:publish:local": "cd dist/fastly && npx @fastly/compute-js-static-publish publish-content --local",
    "fastly:publish": "cd dist/fastly && npx @fastly/compute-js-static-publish publish-content",
    "fastly:publish:staging": "cd dist/fastly && npx @fastly/compute-js-static-publish publish-content --collection-name=staging --expires-in=7d",
    "fastly:promote": "cd dist/fastly && npx @fastly/compute-js-static-publish collections promote --collection-name=staging --to=live",
    "fastly:collections": "cd dist/fastly && npx @fastly/compute-js-static-publish collections list",
    "fastly:clean": "cd dist/fastly && npx @fastly/compute-js-static-publish clean --delete-expired-collections",
    "fastly:deploy": "cd dist/fastly && fastly compute publish",
    "fastly:logs": "cd dist/fastly && fastly log-tail"
  },
  "dependencies": {
    "@sudodevstudio/fastly-for-astro": "^0.5.0",
    "astro": "^6.0.0"
  }
}
